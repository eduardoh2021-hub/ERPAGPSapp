<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada de la app va a la copia en la nube ni pasa a otro móvil (el token cifrado no serviría allí
     y la cola de posiciones y registros pertenece a este dispositivo). El conductor vuelve a entrar en el móvil nuevo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
