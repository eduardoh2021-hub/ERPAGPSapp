{
  "$schema": "https://schemas.actiontruck.local/tokens.json",
  "meta": {
    "marca": "Action Truck",
    "manual": "docs/marca/manual-de-marca.md",
    "nota": "Fuente única de colores, tipografías y espaciados para apps/web y packages/pdf. No declarar valores literales fuera de este archivo."
  },
  "color": {
    "brand": {
      "rojo": { "value": "#E30613", "descripcion": "Icono, líneas, separadores, acentos, acciones primarias" },
      "azul": { "value": "#001659", "descripcion": "Texto de títulos y encabezados" },
      "azulFondo": { "value": "#00235A", "descripcion": "Fondos y bloques sólidos de acento (superficies grandes)" }
    },
    "neutral": {
      "negro": { "value": "#000000", "descripcion": "Texto de cuerpo" },
      "grisTexto": { "value": "#4F4F4F", "descripcion": "Texto secundario / deshabilitado" },
      "grisLinea": { "value": "#E0E0E0", "descripcion": "Bordes y fondos sutiles" },
      "grisFondo": { "value": "#F5F6F8", "descripcion": "Filas alternas, fila activa, paneles y campos de solo lectura" },
      "blanco": { "value": "#FFFFFF", "descripcion": "Fondo principal; texto sobre rojo o azul" }
    },
    "foco": { "value": "{color.brand.azul}", "descripcion": "Anillo de foco del teclado (visible sobre fondo blanco y suave)" },
    "texto": {
      "titulo": { "value": "{color.brand.azul}" },
      "cuerpo": { "value": "{color.neutral.negro}" },
      "cuerpoSecundario": { "value": "{color.neutral.grisTexto}" },
      "sobreRojo": { "value": "{color.neutral.blanco}" },
      "sobreAzul": { "value": "{color.neutral.blanco}" }
    },
    "fondo": {
      "principal": { "value": "{color.neutral.blanco}" },
      "suave": { "value": "{color.neutral.grisFondo}" },
      "acentoRojo": { "value": "{color.brand.rojo}" },
      "acentoAzul": { "value": "{color.brand.azulFondo}" }
    },
    "linea": {
      "separador": { "value": "{color.brand.rojo}" },
      "borde": { "value": "{color.neutral.grisLinea}" }
    },
    "estado": {
      "info": { "value": "{color.brand.azul}" },
      "exito": { "value": "#197A35" },
      "aviso": { "value": "#F2A900" },
      "error": { "value": "{color.brand.rojo}" }
    },
    "mapa": {
      "serie1": { "value": "{color.brand.rojo}", "descripcion": "Series de color de las rutas en el mapa: se asignan por ruta (campo color) o por orden" },
      "serie2": { "value": "{color.brand.azul}" },
      "serie3": { "value": "#0B7285" },
      "serie4": { "value": "#C77700" },
      "serie5": { "value": "#7B3FA0" },
      "serie6": { "value": "#2E7D32" },
      "serie7": { "value": "#8D5524" },
      "serie8": { "value": "#D81B60" },
      "pendiente": { "value": "#8A8F98", "descripcion": "Órdenes pendientes de planificar" },
      "recorridoReal": { "value": "{color.neutral.grisTexto}", "descripcion": "Recorrido real del vehículo (línea fina punteada)" }
    }
  },
  "typography": {
    "fontFamily": {
      "base": "'Yantramanav', Arial, sans-serif"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "bold": 700
    },
    "fontSize": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "22px",
      "2xl": "28px",
      "3xl": "36px",
      "terminal": "22px"
    },
    "lineHeight": {
      "tight": 1.2,
      "base": 1.5,
      "relaxed": 1.7
    }
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "sm": "2px",
    "md": "4px",
    "lg": "8px"
  },
  "border": {
    "width": {
      "hairline": "1px",
      "separador": "2px"
    }
  },
  "logo": {
    "color": "docs/marca/assets/logo-action-truck.png",
    "blanco": "docs/marca/assets/logo-action-truck-blanco.png",
    "ratio": "400:139",
    "anchoMinimoPx": 120
  }
}
